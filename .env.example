# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (website + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- PostgreSQL (the database you created in pgAdmin) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=your_password
# Set to true only for hosted databases that require SSL
DB_SSL=false

# ---- JWT ----
# Use a long random string (at least 32 characters). Never commit the real one.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ---- Uploads ----
MAX_UPLOAD_MB=5
